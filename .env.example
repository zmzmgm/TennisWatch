DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 빈 값이면 사이트별 poll_minutes 사용. 전체 간격 재정의 시 30 또는 60.
WATCH_INTERVAL_MINUTES=
WATCH_DAYS_AHEAD=7
# Worker 전용 설정: 실제 값은 .env와 Cloudflare Secrets에만 저장합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LLM_API_KEY=
LLM_MODEL=
# 다른 공급자를 사용하면 Chat Completions 전체 HTTPS 경로를 지정합니다.
LLM_API_URL=
# 다음 두 값은 prepare-worker가 기존 개인 채팅 연결을 바탕으로 생성합니다.
TELEGRAM_WEBHOOK_SECRET=
ALLOWED_TELEGRAM_CHAT_IDS=
